# Gmail SMTP. SMTP_USER and SMTP_PASSWORD are required to send email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
# Optional; defaults to SMTP_USER.
SENDER_EMAIL=
SENDER_NAME=HireSense AI

# Base URL used for protected resume links in exported workbooks.
# The Vite development server defaults to port 8443; change this if you use another host/port.
FRONTEND_BASE_URL=http://localhost:8443
